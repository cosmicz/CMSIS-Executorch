+++ b/tests/cube_preview/test_table_calibration.c
@@ -0,0 +1,64 @@
+#include <assert.h>
+#include <stdio.h>
+#include <string.h>
+
+#include "cube_preview.h"
+
+/* Private table-calibration-20261018.LK7u1g, frame 2907.  The constants are
+ * raw patch medians captured before white balancing; they are deliberately
+ * shuffled below so expected labels cannot depend on a grid position. */
+static const float captured_raw[9][3] = {
+    {46.5277786f, 60.9861069f, 34.3333359f}, /* Y */
+    {37.5000000f, 33.6944427f, 26.7500000f}, /* R */
+    {36.3611107f, 34.0972214f, 27.2222214f}, /* R */
+    {25.7222214f, 39.2777786f, 29.1250000f}, /* G */
+    {34.4305573f, 31.1388893f, 25.6250000f}, /* R */
+    {25.5138893f, 32.9583321f, 33.2777786f}, /* B */
+    {34.2222214f, 31.4444447f, 25.5833321f}, /* O: RGB-overlaps red */
+    {34.2777786f, 32.5000000f, 25.8888893f}, /* O: RGB-overlaps red */
+    {43.0000000f, 54.6111107f, 32.6944466f}, /* Y */
+};
+
+static void fill_cell(uint8_t *image, unsigned cell, const float rgb[3])
+{
+    const unsigned x0 = cell % 3 * 80;
+    const unsigned y0 = cell / 3 * 80;
+    for (unsigned y = y0; y < y0 + 80; ++y)
+        for (unsigned x = x0; x < x0 + 80; ++x) {
+            uint8_t *p = image + (y * 240 + x) * 3;
+            p[0] = (uint8_t)(rgb[2] + 0.5f); /* input is B, G, R */
+            p[1] = (uint8_t)(rgb[1] + 0.5f);
+            p[2] = (uint8_t)(rgb[0] + 0.5f);
+        }
+}
+
+int main(void)
+{
+    static uint8_t image[240 * 240 * 3];
+    static const unsigned source_for_cell[9] = {5, 0, 7, 3, 1, 8, 6, 4, 2};
+    /* Orange samples remain R here: their RGB values overlap the confirmed
+     * R sample, so a feature-only reader cannot honestly separate them. */
+    static const char ground_truth[] = "BYRGRYRRR";
+    /* Characterize the shipped table-specific orange gate, NOT an accuracy
+     * pass: it misclassifies the confirmed red at shuffled cell 4 as orange.
+     * Keep the original expected labels visible until that defect is fixed. */
+    static const char shipped_readout[] = "BYRGOYRRR";
+    cube_diagnostics diagnostics = {
+        .mode = 1,
+        .white_valid = 1,
+        .white_ref = {38.9652786f, 54.1666641f, 45.4027786f},
+    };
+    char letters[10];
+
+    for (unsigned cell = 0; cell < 9; ++cell)
+        fill_cell(image, cell, captured_raw[source_for_cell[cell]]);
+
+    cube_preview_read_and_draw(image, 240, 240, letters, &diagnostics, 0, 0);
+    assert(strcmp(letters, shipped_readout) == 0);
+    unsigned mismatches = 0;
+    for (unsigned cell = 0; cell < 9; ++cell)
+        mismatches += letters[cell] != ground_truth[cell];
+    assert(mismatches == 1 && ground_truth[4] == 'R' && letters[4] == 'O');
+    assert(diagnostics.abstain_mask == 0);
+    puts("PASS characterization; KNOWN COLOUR DEFECT: confirmed red cell 4 reads orange");
+}
diff --git a/tests/run_cube_tests.sh b/tests/run_cube_tests.sh
new file mode 100644
index 0000000000000000000000000000000000000000..02b9da3b0ded2d130b4ebdcb2beaaaa961ef1a41
--- /dev/null
+++ b/tests/run_cube_tests.sh
@@ -0,0 +1,37 @@
+#!/usr/bin/env bash
+# SPDX-License-Identifier: Apache-2.0
+# Standalone Cube Tutor tests; no downloaded models or hardware required.
+set -euo pipefail
+cd "$(dirname "$0")/.."
+cube_test_build=$(mktemp -d "${TMPDIR:-/tmp}/cube-tutor-tests.XXXXXX")
+flags=(-g -O1 -Wall -Wextra)
+if [[ "${SANITIZE:-0}" == 1 ]]; then
+    flags+=(-fsanitize=address,undefined -fno-omit-frame-pointer)
+fi
+includes=(
+    -I source/hal/source/components/camera/source/alif/source
+    -I source/hal/source/components/camera/source/alif/include
+    -I source/app/use_case/alif_object_detection/include
+)
+count=0
+for source in tests/cube_preview/*.c tests/cube_cross_hint_test.c tests/test_cube_*.c; do
+    binary="$cube_test_build/$(basename "$source" .c)"
+    "${CC:-cc}" -std=c11 "${flags[@]}" "${includes[@]}" "$source" -lm -o "$binary"
+    "$binary"
+    count=$((count + 1))
+done
+for rotation in 90 180 270; do
+    binary="$cube_test_build/preview-$rotation"
+    "${CC:-cc}" -std=c11 "${flags[@]}" "${includes[@]}" \
+        -DCUBE_DISPLAY_ROTATION="$rotation" tests/cube_preview/test_cube_preview.c -lm -o "$binary"
+    "$binary"
+    count=$((count + 1))
+done
+for source in tests/cube_face*test.cpp; do
+    binary="$cube_test_build/$(basename "$source" .cpp)"
+    "${CXX:-c++}" -std=c++17 "${flags[@]}" "${includes[@]}" "$source" -o "$binary"
+    "$binary"
+    count=$((count + 1))
+done
+echo "PASS: $count Cube Tutor host executions (includes known-defect characterization)."
+echo "Binaries retained in $cube_test_build"
diff --git a/tests/test_cube_cross_planner.c b/tests/test_cube_cross_planner.c
new file mode 100644
index 0000000000000000000000000000000000000000..dd8de036ae7bf069ee91fe7b35bc351673020097
--- /dev/null
+++ b/tests/test_cube_cross_planner.c
@@ -0,0 +1,72 @@
+/* SPDX-License-Identifier: Apache-2.0
+ * Host regressions supplied with the Cube Tutor planner/memory handoff. */
+#include <assert.h>
+#include <stdio.h>
+#include <string.h>
+#include "cube_face_memory.h"
+#include "cube_cross_planner.h"
+
+static void remember(cube_face_memory *m, const char *face)
+{
+    for (int i = 0; i < CUBE_MEMORY_STABLE_FRAMES; ++i) cube_face_memory_update(m, face);
+}
+static void solved_memory(cube_face_memory *m)
+{
+    cube_face_memory_reset(m);
+    remember(m, "WWWWWWWWW"); remember(m, "OOOOOOOOO"); remember(m, "BBBBBBBBB");
+    remember(m, "YYYYYYYYY"); remember(m, "RRRRRRRRR"); remember(m, "GGGGGGGGG");
+}
+
+int main(void)
+{
+    cube_face_memory m; char line[CUBE_MEMORY_LINE_LEN]; uint8_t state[54], next[54], plan[CUBE_PLAN_MAX_DEPTH];
+    solved_memory(&m);
+    assert(cube_state_from_memory(&m, state) && cube_cross_solved_mask(state) == 0xFu);
+    assert(cube_plan_line(&m, line, sizeof line) == 0 && strstr(line, "DONE"));
+    /* F from solved: the one-turn fix is F counterclockwise (turn id 2*3+1 = 7). */
+    cube_apply_turn(state, 2 * 3 + 0, next);
+    assert(cube_cross_solved_mask(next) == 0xEu);
+    assert(cube_plan_cross(next, plan) == 1 && plan[0] == 7);
+    /* Asymmetric face data must really be un-mirrored, not merely copied. */
+    remember(&m, "ROBWWGYRO");
+    assert(cube_state_from_memory(&m, state));
+    assert(state[0] == cube_colour_index('B') && state[2] == cube_colour_index('R'));
+    assert(state[3] == cube_colour_index('G') && state[5] == cube_colour_index('W'));
+    assert(state[6] == cube_colour_index('O') && state[8] == cube_colour_index('Y'));
+    /* Each turn is a permutation; four quarter turns restore an asymmetric state. */
+    for (int face = 0; face < 6; ++face) {
+        uint8_t unique[54], transformed[54];
+        for (int i = 0; i < 54; ++i) unique[i] = (uint8_t)i;
+        cube_apply_turn(unique, face * 3, transformed);
+        assert(memcmp(unique, transformed, 54) != 0);
+        for (int repeat = 1; repeat < 4; ++repeat) {
+            memcpy(unique, transformed, 54);
+            cube_apply_turn(unique, face * 3, transformed);
+        }
+        for (int i = 0; i < 54; ++i) assert(transformed[i] == i);
+    }
+    /* Scrambles: each plan homes one more edge, keeps the rest, and the cross completes. */
+    unsigned seed = 12345;
+    for (int trial = 0; trial < 20; ++trial) {
+        memcpy(state, next, 54); int last = -1;
+        for (int k = 0; k < 20; ++k) { seed = seed * 1103515245u + 12345u; int t = (int)((seed >> 8) % 18); if (t / 3 == last) t = (t + 3) % 18; cube_apply_turn(state, t, next); memcpy(state, next, 54); last = t / 3; }
+        int plans = 0;
+        while (cube_cross_solved_mask(state) != 0xFu) {
+            const unsigned before = cube_cross_solved_mask(state);
+            const int n = cube_plan_cross(state, plan);
+            assert(n > 0 && n <= CUBE_PLAN_MAX_DEPTH);
+            for (int i = 0; i < n; ++i) { cube_apply_turn(state, plan[i], next); memcpy(state, next, 54); }
+            const unsigned after = cube_cross_solved_mask(state);
+            assert((after & before) == before && after != before);
+            assert(++plans <= 4);
+        }
+    }
+    /* The memory line names a real turn; mirrored columns are undone on the way in. */
+    solved_memory(&m);
+    remember(&m, "WWWWWWBBB"); remember(&m, "WWWBBBBBB");  /* bottom row of white and top row of blue swapped: F2-like */
+    assert(cube_plan_line(&m, line, sizeof line) > 0 && strstr(line, "NEXT MOVE: TURN THE"));
+    cube_face_memory_reset(&m); remember(&m, "WWWWWWWWW");
+    assert(cube_plan_line(&m, line, sizeof line) == -2 && strstr(line, "SIX FACES"));
+    puts("PASS cross planner: solved, one-turn fix, 20 scrambles monotone, words, needs six faces");
+    return 0;
+}
diff --git a/tests/test_cube_face_memory.c b/tests/test_cube_face_memory.c
new file mode 100644
index 0000000000000000000000000000000000000000..675b7e22ea945f1147f29e77e00b25f9126b7de0
--- /dev/null
+++ b/tests/test_cube_face_memory.c
@@ -0,0 +1,47 @@
+/* SPDX-License-Identifier: Apache-2.0
+ * Host regressions supplied with the Cube Tutor planner/memory handoff. */
+#include <assert.h>
+#include <stdio.h>
+#include <string.h>
+#include "cube_face_memory.h"
+
+static int stable(cube_face_memory *m, const char *face)
+{
+    int r = -1;
+    for (int i = 0; i < CUBE_MEMORY_STABLE_FRAMES; ++i) r = cube_face_memory_update(m, face);
+    return r;
+}
+
+int main(void)
+{
+    cube_face_memory m; cube_face_memory_reset(&m);
+    char line[CUBE_MEMORY_LINE_LEN];
+    assert(cube_face_memory_line(&m, line, sizeof line) == -1 && strstr(line, "FACES SEEN 0/6"));
+    assert(cube_face_memory_update(&m, "W?WWWWWWW") == -1);
+    assert(cube_face_memory_update(&m, "WWWWWWWWW") == -1);          /* one frame is not enough */
+    assert(cube_face_memory_update(&m, "WWWWWWWWW") == -1);
+    assert(cube_face_memory_update(&m, "WWWWWWWWW") == 0 && m.seen == 1u);
+    assert(stable(&m, "BBBBBBBBB") == 2);
+    assert(cube_face_memory_line(&m, line, sizeof line) == -1 && strstr(line, "FACES SEEN 2/6: W B"));
+    assert(stable(&m, "OOOOOOOOO") == 1);
+    assert(stable(&m, "RRRRRRRRR") == 4);
+    assert(stable(&m, "GGGGGGGGG") == 5);
+    assert(cube_face_memory_cross_known(&m));
+    assert(cube_face_memory_line(&m, line, sizeof line) == 4 && strstr(line, "4/4"));
+    /* A single flickered frame (orange centre read as red) must not touch the red face. */
+    assert(cube_face_memory_update(&m, "OOOOROOOO") == -1);
+    assert(cube_face_memory_line(&m, line, sizeof line) == 4);
+    /* A flicker followed by two more identical frames IS stable and is stored (by its centre). */
+    assert(cube_face_memory_update(&m, "OOOOROOOO") == -1);
+    assert(cube_face_memory_update(&m, "OOOOROOOO") == 4);
+    assert(cube_face_memory_line(&m, line, sizeof line) == 3 && strstr(line, "3/4") && strstr(line, "R(W/O)"));
+    /* Restoring the red face returns to 4/4. */
+    assert(stable(&m, "RRRRRRRRR") == 4);
+    assert(cube_face_memory_line(&m, line, sizeof line) == 4);
+    /* Flipped white-blue edge names both stickers. */
+    assert(stable(&m, "WWWWWWWBW") == 0 && stable(&m, "BWBBBBBBB") == 2);
+    assert(cube_face_memory_line(&m, line, sizeof line) == 3 && strstr(line, "B(B/W)"));
+    assert(strlen(line) < CUBE_MEMORY_LINE_LEN - 1);
+    puts("PASS face memory v2: three identical frames to remember, flicker ignored, stickers named");
+    return 0;
+}
