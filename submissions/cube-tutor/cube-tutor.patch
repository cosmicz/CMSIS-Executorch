diff --git a/tests/cube_cross_hint_test.c b/tests/cube_cross_hint_test.c
new file mode 100644
index 00000000..46257830
--- /dev/null
+++ b/tests/cube_cross_hint_test.c
@@ -0,0 +1,30 @@
+#include <assert.h>
+#include <stdio.h>
+#include <string.h>
+#include "cube_cross_hint.h"
+
+static int hint(const char *face, char *out) { return cube_cross_hint(face, out, CUBE_CROSS_HINT_LEN); }
+
+int main(void)
+{
+    char out[CUBE_CROSS_HINT_LEN];
+    assert(hint("WWWWWWWWW", out) == 4 && strstr(out, "4/4"));
+    assert(hint("RWBWWGOYW", out) == 2 && strstr(out, "2/4"));           /* two white edges on top */
+    assert(hint("?????????", out) == -1 && strstr(out, "SHOW ONE FACE"));
+    assert(hint("YWYYYYYWY", out) == 2 && strstr(out, "BOTTOM") && strstr(out, "TWICE"));
+    assert(hint("YYYYYYYYY", out) == 0 && strstr(out, "NO WHITE EDGE"));
+    assert(hint("BBBBBBBBB", out) == 0 && strstr(out, "blue EDGE ALIGNED"));
+    assert(hint("BWBBBBBBB", out) == 1 && strstr(out, "FLIPPED"));
+    assert(hint("BGBBBBBBB", out) == 0 && strstr(out, "TOP EDGE ABOVE blue IS green"));
+    assert(hint("BGBWBBBBB", out) == 1 && strstr(out, "MIDDLE LAYER"));
+    assert(hint("BGBBBBBWB", out) == 1 && strstr(out, "AT BOTTOM OF blue"));
+    assert(hint("B?BBBBBBB", out) == 0 && strstr(out, "UNCLEAR"));
+    /* Every line fits the label buffer with its terminator. */
+    const char *faces[] = {"WWWWWWWWW", "RWBWWGOYW", "YWYYYYYWY", "BWBBBBBBB", "BGBWBBBBB", "BGBBBBBWB"};
+    for (unsigned i = 0; i < sizeof faces / sizeof *faces; ++i) {
+        hint(faces[i], out);
+        assert(strlen(out) < CUBE_CROSS_HINT_LEN);
+    }
+    puts("PASS single-face white-cross hint: top, bottom, side aligned/flipped/middle/bottom, unsure");
+    return 0;
+}
diff --git a/tests/cube_face_multi_select_test.cpp b/tests/cube_face_multi_select_test.cpp
new file mode 100644
index 00000000..5e28ffb5
--- /dev/null
+++ b/tests/cube_face_multi_select_test.cpp
@@ -0,0 +1,37 @@
+#include "CubeFaceMultiSelect.hpp"
+
+#include <array>
+#include <cassert>
+
+int main()
+{
+    constexpr size_t channels = 5, candidates = 756;
+    std::array<float, channels * candidates> output{};
+    const auto set = [&](size_t c, float x, float y, float w, float h, float conf) {
+        output[0 * candidates + c] = x; output[1 * candidates + c] = y;
+        output[2 * candidates + c] = w; output[3 * candidates + c] = h; output[4 * candidates + c] = conf;
+    };
+    const auto valueAt = [&](size_t index) { return output[index]; };
+    size_t selected[3];
+    /* Two faces apart, a near-duplicate of the first, one bright sticker, one weak box. */
+    set(10, 0.30f, 0.50f, 0.30f, 0.30f, 0.60f);   /* face A, area 0.09 */
+    set(11, 0.31f, 0.50f, 0.30f, 0.30f, 0.55f);   /* duplicate of A, IoU ~0.94 */
+    set(20, 0.75f, 0.50f, 0.40f, 0.40f, 0.40f);   /* face B, area 0.16 (largest) */
+    set(30, 0.50f, 0.20f, 0.17f, 0.16f, 0.999f);  /* sticker, area 0.027 */
+    set(40, 0.50f, 0.80f, 0.30f, 0.30f, 0.10f);   /* below threshold */
+    size_t n = alif::app::object_detection::SelectCubeFaces(valueAt, candidates, 0.25f, 0.04f, 0.5f, 3, selected);
+    assert(n == 2);
+    assert(selected[0] == 20 && selected[1] == 10);  /* largest first, duplicate and sticker gone */
+    /* Four faces: at most three, largest first. */
+    set(50, 0.20f, 0.20f, 0.25f, 0.25f, 0.50f);
+    set(60, 0.80f, 0.85f, 0.20f, 0.20f, 0.50f);
+    n = alif::app::object_detection::SelectCubeFaces(valueAt, candidates, 0.25f, 0.04f, 0.5f, 3, selected);
+    assert(n == 3 && selected[0] == 20 && selected[1] == 10 && selected[2] == 50);
+    /* Single-face scene unchanged: one result. */
+    std::array<float, channels * candidates> single{};
+    single[2 * candidates + 5] = 0.4f; single[3 * candidates + 5] = 0.4f; single[4 * candidates + 5] = 0.9f;
+    const auto one = [&](size_t index) { return single[index]; };
+    n = alif::app::object_detection::SelectCubeFaces(one, candidates, 0.25f, 0.04f, 0.5f, 3, selected);
+    assert(n == 1 && selected[0] == 5);
+    return 0;
+}
