diff --git a/tests/cube_preview/test_button_actions.c b/tests/cube_preview/test_button_actions.c
new file mode 100644
index 0000000000000000000000000000000000000000..bf9802e17ba4f41edb2b1417f787bf23e7bb4d26
--- /dev/null
+++ b/tests/cube_preview/test_button_actions.c
@@ -0,0 +1,50 @@
+#include <assert.h>
+#include <stdio.h>
+#include "cube_button_actions.h"
+
+static void short_press(cube_button_state *s, unsigned mask, unsigned now, unsigned mode)
+{
+    assert(cube_button_action(s, mask, now, mode) == 0);
+    assert(cube_button_action(s, mask, now + 50, mode) == 0);
+    assert(cube_button_action(s, mask, now + 500, mode) == 0);
+    assert(cube_button_action(s, 0, now + 550, mode) == 0);
+    assert(cube_button_action(s, 0, now + 600, mode) == (mode ? 2u : 1u));
+    assert(cube_button_action(s, 0, now + 800, mode) == 0);
+}
+int main(void)
+{
+    for (unsigned button = 0; button < 5; ++button) {
+        cube_button_state s = {0};
+        short_press(&s, 1u << button, 100, 1); /* READ -> CAL. */
+        short_press(&s, 1u << button, 1100, 0); /* CAL -> validated lock request. */
+    }
+    cube_button_state s = {0};
+    assert(cube_button_action(&s, 1, 100, 1) == 0);
+    assert(cube_button_action(&s, 1, 150, 1) == 0);
+    assert(cube_button_action(&s, 3, 500, 1) == 0); /* Chord does not re-arm. */
+    assert(cube_button_action(&s, 2, 700, 1) == 0); /* First button released. */
+    assert(cube_button_action(&s, 0, 800, 1) == 0);
+    assert(cube_button_action(&s, 0, 850, 1) == 2);
+    assert(cube_button_action(&s, 0, 900, 0) == 0); /* No double transition. */
+    short_press(&s, 31, 1000, 0); /* All-five chord: one lock request. */
+    s = (cube_button_state){0};
+    assert(cube_button_action(&s, 4, 100, 1) == 0);
+    assert(cube_button_action(&s, 0, 120, 1) == 0);
+    assert(cube_button_action(&s, 0, 200, 1) == 0); /* Bounce ignored. */
+    assert(cube_button_action(&s, 4, 300, 1) == 0);
+    assert(cube_button_action(&s, 4, 350, 1) == 0);
+    assert(cube_button_action(&s, 4, 1850, 1) == 2);
+    assert(cube_button_action(&s, 12, 2200, 0) == 0);
+    assert(cube_button_action(&s, 0, 2300, 0) == 0);
+    assert(cube_button_action(&s, 0, 2350, 0) == 0); /* Long release cannot lock. */
+    short_press(&s, 16, 2500, 0);
+    s = (cube_button_state){0};
+    assert(cube_button_action(&s, 1, 100, 1) == 0);
+    assert(cube_button_action(&s, 1, 150, 1) == 0);
+    assert(cube_button_action(&s, 0, 200, 1) == 0);
+    assert(cube_button_action(&s, 2, 220, 1) == 0); /* Not fully released for50ms. */
+    assert(cube_button_action(&s, 2, 300, 1) == 0);
+    assert(cube_button_action(&s, 0, 400, 1) == 0);
+    assert(cube_button_action(&s, 0, 450, 1) == 2);
+    puts("PASS five buttons, held/chord, debounce/release, long-hold one-shot");
+}
diff --git a/tests/cube_preview/test_camera_mapping.c b/tests/cube_preview/test_camera_mapping.c
new file mode 100644
index 0000000000000000000000000000000000000000..9f254d48eb5da5bcc32c0d4eb426ea7ca86d0083
--- /dev/null
+++ b/tests/cube_preview/test_camera_mapping.c
@@ -0,0 +1,38 @@
+#include <assert.h>
+#include <math.h>
+#include <stdio.h>
+#include "cube_camera_mapping.h"
+
+int main(void)
+{
+    /* Asymmetric sensor ABC/DEF -> clockwise DA/EB/FC -> mirror AD/BE/CF.
+     * Every output row and all four corners are distinct. */
+    const unsigned expected[6] = {0, 3, 1, 4, 2, 5};
+    const unsigned old_mirror_only[6] = {2, 1, 0, 5, 4, 3};
+    unsigned differs = 0;
+    for (unsigned y = 0; y < 3; ++y)
+        for (unsigned x = 0; x < 2; ++x) {
+            unsigned index = cube_camera_source_index(3, 2, 2, 3, x, y);
+            assert(index == expected[y * 2 + x]);
+            differs += index != old_mirror_only[y * 2 + x];
+        }
+    assert(differs > 0); /* Deleting the rotation must fail the exact mapping. */
+    /* Native 8x6 -> rotated6x8 -> central6x3 crop -> landscape8x4.
+     * Literal indices independently encode clockwise source rows and crop. */
+    const unsigned crop_expected[4][8] = {
+        {2,2,10,18,26,26,34,42}, {2,2,10,18,26,26,34,42},
+        {3,3,11,19,27,27,35,43}, {4,4,12,20,28,28,36,44}
+    };
+    for (unsigned y = 0; y < 4; ++y)
+        for (unsigned x = 0; x < 8; ++x)
+            assert(cube_camera_source_index(8, 6, 8, 4, x, y) == crop_expected[y][x]);
+    /* An off-centre model rect maps through the same rotate/crop/mirror
+     * transform: source x/y become logical y/x respectively. */
+    cube_camera_point first = cube_camera_model_to_preview(480, 480, 800, 480,
+                                                             192, 192, 48, 24);
+    cube_camera_point last = cube_camera_model_to_preview(480, 480, 800, 480,
+                                                            192, 192, 108, 54);
+    assert(fabsf(first.x - 100) < 0.01f && fabsf(first.y - 40) < 0.01f);
+    assert(fabsf(last.x - 225) < 0.01f && fabsf(last.y - 290) < 0.01f);
+    puts("PASS clockwise camera + crop/mirror + off-centre model-to-preview box");
+}
diff --git a/tests/cube_preview/test_cube_preview.c b/tests/cube_preview/test_cube_preview.c
new file mode 100644
index 0000000000000000000000000000000000000000..488222f351174d237c8c3f9561c5a0b54202c7a5
--- /dev/null
+++ b/tests/cube_preview/test_cube_preview.c
@@ -0,0 +1,73 @@
+#include <assert.h>
+#include <stddef.h>
+#include <stdio.h>
+#include <string.h>
+#define RTE_PANEL_HACTIVE_TIME 480
+#define RTE_PANEL_VACTIVE_LINE 800
+#include "cube_display_geometry.h"
+#include "cube_preview.h"
+
+static uint8_t image[CUBE_PREVIEW_WIDTH * CUBE_PREVIEW_HEIGHT * 3];
+static void fill_cell(unsigned cell, unsigned r, unsigned g, unsigned b)
+{
+    unsigned x0 = (CUBE_PREVIEW_WIDTH - 240) / 2 + cell % 3 * 80;
+    unsigned y0 = (CUBE_PREVIEW_HEIGHT - 240) / 2 + cell / 3 * 80;
+    for (unsigned y = y0; y < y0 + 80; ++y)
+        for (unsigned x = x0; x < x0 + 80; ++x) {
+            uint8_t *p = image + (y * CUBE_PREVIEW_WIDTH + x) * 3;
+            p[0] = b; p[1] = g; p[2] = r;
+        }
+}
+static void white_cross(void)
+{
+    memset(image, 128, sizeof image);
+    for (unsigned cell = 0; cell < 9; ++cell) fill_cell(cell, 180, 200, 220);
+    fill_cell(0, 200, 30, 40); fill_cell(2, 40, 170, 70);
+    fill_cell(6, 30, 80, 200); fill_cell(8, 240, 120, 30);
+    fill_cell(4, 30, 80, 200);
+}
+static void read_frame(cube_diagnostics *d, char letters[10], uint32_t request)
+{
+    cube_preview_read_and_draw(image, CUBE_PREVIEW_WIDTH, CUBE_PREVIEW_HEIGHT,
+                              letters, d, 100, request);
+}
+int main(void)
+{
+    cube_diagnostics d = {.mode = 1};
+    char letters[10];
+    white_cross(); read_frame(&d, letters, 0);
+    assert(d.mode == 1 && !d.white_valid); /* Boot must not auto-lock. */
+    white_cross(); read_frame(&d, letters, 2);
+    assert(d.mode == 0 && d.cross_valid && d.reference_mask == 0xAA);
+    assert(d.candidate_rgb[0] == 180 && d.candidate_rgb[1] == 200);
+    white_cross(); read_frame(&d, letters, 1);
+    assert(d.white_valid && d.logo_ref_valid && d.mode == 1);
+    assert(d.white_success_count == 1 && d.white_ref[0] == 180);
+    assert(d.logo_ref_raw[0] == 30 && d.logo_ref_raw[1] == 80);
+    assert(fabsf(d.logo_ref_rgb[0] - 30 * 235.0f / 180) < 0.001f);
+    white_cross(); read_frame(&d, letters, 0);
+    assert(letters[6] == 'W' && (d.logo_mask & (1u << 6)));
+    white_cross(); fill_cell(6, 20, 40, 240); read_frame(&d, letters, 0);
+    assert(letters[6] == 'B' && !(d.logo_mask & (1u << 6)));
+    white_cross(); fill_cell(4, 180, 200, 220);
+    unsigned cx = CUBE_PREVIEW_WIDTH / 2, cy = CUBE_PREVIEW_HEIGHT / 2;
+    for (unsigned y = cy - 5; y < cy + 5; ++y)
+        for (unsigned x = cx - 5; x < cx + 5; ++x) {
+            uint8_t *p = image + (y * CUBE_PREVIEW_WIDTH + x) * 3;
+            p[0] = 200; p[1] = 80; p[2] = 30;
+        }
+    read_frame(&d, letters, 0);
+    assert(d.raw_rgb[4][0] == 180 && d.raw_rgb[4][1] == 200);
+    assert(image[0] != 128); /* Gains visibly transform preview pixels. */
+    white_cross(); fill_cell(1, 200, 30, 40); read_frame(&d, letters, 2);
+    assert(d.mode == 0 && !d.cross_valid && !d.logo_ref_valid);
+    white_cross(); fill_cell(1, 200, 30, 40); read_frame(&d, letters, 1);
+    assert(d.mode == 0 && !d.white_valid && d.lock_rejected);
+    white_cross(); read_frame(&d, letters, 1);
+    assert(d.mode == 1 && d.white_valid && !d.lock_rejected);
+    assert(sizeof(cube_diagnostics) == 736 && offsetof(cube_diagnostics, logo_ref_raw) == 592);
+    assert(CUBE_STATUS_Y > (CUBE_PREVIEW_HEIGHT + 240) / 2);
+    assert(CUBE_STATUS_Y + 80 <= CUBE_PREVIEW_HEIGHT);
+    printf("PASS rotation=%d canvas=%dx%d white-cross/logo/reject/relock/visible-WB\n",
+           CUBE_DISPLAY_ROTATION, CUBE_PREVIEW_WIDTH, CUBE_PREVIEW_HEIGHT);
+}
diff --git a/tests/cube_preview/test_neutral_white.c b/tests/cube_preview/test_neutral_white.c
new file mode 100644
index 0000000000000000000000000000000000000000..8d76bd3fd9e5eef0c463c2cb871b672509992287
--- /dev/null
+++ b/tests/cube_preview/test_neutral_white.c
@@ -0,0 +1,41 @@
+#include <assert.h>
+#include <stdio.h>
+#include <string.h>
+#include "cube_preview.h"
+
+static void expect(const float rgb[3], unsigned colour)
+{
+    float hsv[3];
+    assert(cube_hsv_colour(rgb, hsv) == colour);
+}
+static void pipeline(unsigned r, unsigned g, unsigned b, char expected)
+{
+    static uint8_t image[240 * 240 * 3];
+    for (unsigned i = 0; i < 240 * 240; ++i) {
+        image[i * 3] = b; image[i * 3 + 1] = g; image[i * 3 + 2] = r;
+    }
+    cube_diagnostics d = {.mode = 1, .white_valid = 1,
+        .white_ref = {126.8611145f, 137.2430420f, 77.6527786f}};
+    char letters[10];
+    cube_preview_read_and_draw(image, 240, 240, letters, &d, 0, 0);
+    for (unsigned i = 0; i < 9; ++i) assert(letters[i] == expected);
+}
+int main(void)
+{
+    /* Exact archived green-white frame840 corrected RGB; red previously W. */
+    expect((float[3]){167.3609467f,108.9920654f,122.5648422f}, 2);
+    expect((float[3]){85.7001266f,97.9335175f,138.4949036f}, 4);
+    /* Captured dark green is not white; pipeline must continue to ABSTAIN,
+     * not invent a green hue remapping for the blue-shifted measurement. */
+    float hsv[3];
+    assert(cube_hsv_colour((float[3]){94.2418442f,119.1706772f,126.8941269f}, hsv) != 0);
+    expect((float[3]){255,255,255}, 0);
+    expect((float[3]){253.8586578f,255,255}, 0);
+    expect((float[3]){220.4832306f,217.9200745f,222.1361999f}, 0);
+    expect((float[3]){130,180,140}, 5); /* Chromatic green cannot become W. */
+    pipeline(90,64,40,'R'); /* Rounded captured red raw RGB + SAME saved gains. */
+    pipeline(46,57,46,'B');
+    pipeline(51,70,42,'?');
+    pipeline(150,167,95,'W'); /* Clipped-white ambiguity remains, not fixed here. */
+    puts("PASS captured red R, blue B, green uncertain, neutral whites W");
+}
